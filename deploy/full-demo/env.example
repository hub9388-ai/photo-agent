# EXAMPLES ONLY. Copy to .env on the future server; never copy model.env or local photos.
SITE_HOST=demo.example.com
OBJECTS_HOST=objects.example.com
ACME_EMAIL=you@example.com
DEMO_USER=interview
# Generate with: docker run --rm -it caddy:2 caddy hash-password
# Keep the bcrypt value single-quoted so Compose treats $ literally.
DEMO_PASSWORD_HASH='REPLACE_WITH_CADDY_BCRYPT_HASH'
DEMO_DAILY_POST_LIMIT=60

# Generate independent long random HEX passwords, avoiding URL special characters.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_HEX
MINIO_USER=photoaidemo
MINIO_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_HEX
RETOUCH_JWT_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARACTERS

DEEPSEEK_API_KEY=REPLACE_ON_SERVER
DEEPSEEK_MODEL=deepseek-flash
DASHSCOPE_API_KEY=REPLACE_ON_SERVER
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com
IMAGE_EDIT_MODEL=qwen-image-2.1-pro
TEXT_TO_IMAGE_MODEL=qwen-image-3.0-pro
PLANNER_MODEL=qwen-plus
# Optional. Existing model/API permissions and free-tier switches still apply.
AMAP_KEY=
