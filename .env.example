# 摄影全栈 Agent API - 示例环境变量
# 复制为 .env 或 model.env 后填写真实值；不要提交真实密钥。
# 注意：dotenv 语法不是 Python 字典语法，值后面不要加逗号，变量名前不要加 $。

PHOTO_APP_NAME=Photography Agent API
PHOTO_APP_VERSION=0.1.0
PHOTO_ENV=development
PHOTO_DEBUG=false
PHOTO_MEDIA_ROOT=media
PHOTO_MAX_UPLOAD_BYTES=26214400
PHOTO_DATABASE_PATH=data/app.sqlite3

# 当前摄影项目使用 DeepSeek；独立修图服务的 DashScope 配置另行管理。
PHOTO_MODEL_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/anthropic
DEEPSEEK_MODEL=deepseek-flash

# 仅 PHOTO_MODEL_PROVIDER=anthropic 时使用以下配置。
# ANTHROPIC_API_KEY 与 ANTHROPIC_AUTH_TOKEN 二选一即可。
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
ANTHROPIC_BASE_URL=
ANTHROPIC_MODEL=claude-sonnet-4-6

# 可选：其他模型或搜索 provider 的本地配置。
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=
