+import { useEditorUi } from '@/stores/editorUi'
+import { errorMessage, useAuthActions, useCurrentUser } from '@/hooks/useAuth'
+
+const PHOTOAI_ORIGIN = new URL(import.meta.env.VITE_PHOTOAI_ORIGIN || 'http://localhost:3000').origin
+
+/** Local adapter: credentials remain in this service; only image bytes cross the frame boundary. */
+export default function PhotoAIImportPage() {
+  const navigate = useNavigate()
+  const { user, isLoading } = useCurrentUser()
+  const { login, register } = useAuthActions()
+  const busy = useRef(false)
+  const [message, setMessage] = useState('请在 PhotoAI 中选择照片并发送。')
+  const [username, setUsername] = useState('')
+  const [password, setPassword] = useState('')
+  const [mode, setMode] = useState<'login' | 'register'>('login')
+  const action = mode === 'login' ? login : register
+
+  useEffect(() => {
+    if (!user || window.parent === window) return
+    function reply(data: Record<string, unknown>) {
+      window.parent.postMessage({ ...data, version: 1 }, PHOTOAI_ORIGIN)
+    }
+    async function receive(event: MessageEvent) {
+      if (event.origin !== PHOTOAI_ORIGIN || event.source !== window.parent) return
+      const data = event.data
+      if (!data || data.type !== 'photoai:import' || data.version !== 1 ||
+        typeof data.requestId !== 'string' || data.requestId.length > 100 || busy.current) return
+      const file = data.file
+      if (!(file instanceof File) || !ACCEPTED_TYPES.includes(file.type) ||
+        !file.size || file.size > MAX_UPLOAD_BYTES) {
+        reply({ type: 'photoai:error', requestId: data.requestId, message: '仅支持不超过 20 MB 的 JPG、PNG、WebP 图片。' })
+        return
+      }
+      busy.current = true
+      setMessage('正在导入照片并创建会话…')
+      try {
+        const advice = data.advice === undefined ? null : parsePostAdvice(data.advice)
+        const asset = await assetsApi.upload(file)
+        const session = await sessionsApi.create({ current_asset_id: asset.id, title: `PhotoAI · ${file.name}` })
+        if (advice) saveAdviceDraft(session.id, { advice, values: advice.params, revision: session.revision, applied: false })
+        useEditorUi.getState().setAdjustPreview(null)
+        useEditorUi.getState().selectLayer(null)
+        useEditorUi.getState().setPanel(advice ? 'adjust' : null)
+        reply({ type: 'photoai:imported', requestId: data.requestId, sessionId: session.id })
+        navigate(`/editor/${session.id}`, { replace: true })
+      } catch (error) {
+        const message = errorMessage(error)
+        setMessage(message)
+        reply({ type: 'photoai:error', requestId: data.requestId, message })
+      } finally {
+        busy.current = false
+      }
+    }
+    window.addEventListener('message', receive)
+    reply({ type: 'photoai:ready' })
+    return () => window.removeEventListener('message', receive)
+  }, [user, navigate])
+
+  if (isLoading) return <p className="p-8">正在检查修图账号…</p>
+  if (user) return <div className="p-8"><h2 className="text-xl font-bold">修图服务已连接</h2><p className="mt-3">{message}</p></div>
+  return (
+    <form className="mx-auto mt-12 flex max-w-sm flex-col gap-4 p-6" onSubmit={(event) => {
+      event.preventDefault()
+      action.mutate({ username, password })
+    }}>
+      <h2 className="text-xl font-bold">{mode === 'login' ? '登录修图工作台' : '注册修图账号'}</h2>
+      <p className="text-sm">账号由修图服务单独管理。登录后可接收 PhotoAI 照片。</p>
+      <label>用户名<input className="mt-1 w-full rounded border p-2" required value={username}
+        onChange={(event) => setUsername(event.target.value)} autoComplete="username" /></label>
+      <label>密码<input className="mt-1 w-full rounded border p-2" required type="password" value={password}
+        onChange={(event) => setPassword(event.target.value)} autoComplete={mode === 'login' ? 'current-password' : 'new-password'} /></label>
+      {action.isError && <p role="alert">{errorMessage(action.error)}</p>}
+      <button className="rounded bg-black p-2 text-white" disabled={action.isPending} type="submit">{action.isPending ? '处理中…' : '继续'}</button>
+      <button type="button" onClick={() => { action.reset(); setMode(mode === 'login' ? 'register' : 'login') }}>
+        {mode === 'login' ? '没有账号？注册' : '已有账号？登录'}
+      </button>
+    </form>
+  )
+}
