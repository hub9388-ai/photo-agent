+def _inline_image(data: bytes) -> str:
+    # PhotoAI can hand off original JPEG/WebP bytes, not only processed PNGs.
+    # Label the real format rather than declaring every input to be PNG.
+    try:
+        with Image.open(io.BytesIO(data)) as image:
+            mime = {"JPEG": "image/jpeg", "PNG": "image/png", "WEBP": "image/webp"}.get(image.format)
+            if not mime or not 1 <= min(image.size) or max(image.size) > 8000 or max(image.size) / min(image.size) > 10:
+                raise ProviderError("图像模型需要有效的 JPG、PNG 或 WebP，边长不超过8000且宽高比不超过10:1。")
+            if len(data) > _MAX_INPUT_BYTES:
+                # Only encode a transport copy. Keep the stored original, canvas
+                # size and alpha unchanged; do not repeat completed edits.
+                rgba = image.convert("RGBA")
+                transparent = rgba.getchannel("A").getextrema()[0] < 255
+                prepared = rgba if transparent else rgba.convert("RGB")
+                image_format = "WEBP" if transparent else "JPEG"
+                for quality in (95, 90, 85, 75, 60, 45):
+                    buffer = io.BytesIO()
+                    prepared.save(buffer, image_format, quality=quality)
+                    candidate = buffer.getvalue()
+                    if len(candidate) <= _MAX_INPUT_BYTES:
+                        logger.info("Model transport image encoded: input_bytes=%s output_bytes=%s format=%s quality=%s size=%s",
+                                    len(data), len(candidate), image_format, quality, image.size)
+                        data = candidate
+                        mime = "image/webp" if transparent else "image/jpeg"
+                        break
+                else:
+                    raise ProviderError("图片压缩后仍超过模型10MB限制，请缩小图片后重试。")
+    except (OSError, ValueError) as exc:
+        raise ProviderError("无法识别待编辑图片，请重新导入有效照片。") from exc
+    return f"data:{mime};base64,{base64.b64encode(data).decode()}"
+
+
