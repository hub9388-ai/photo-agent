+def planner_failure_message(exc: Exception) -> str | None:
+    """Translate structured provider errors without exposing response bodies or keys."""
+    seen = set()
+    current = exc
+    while current is not None and id(current) not in seen:
+        seen.add(id(current))
+        body = getattr(current, "body", None)
+        detail = body.get("error", body) if isinstance(body, dict) else {}
+        code = detail.get("code") if isinstance(detail, dict) else None
+        status = getattr(current, "status_code", None)
+        if code == "Arrearage":
+            return "阿里云规划模型调用被拒绝（Arrearage）：请检查 API Key 所属账户的欠费或账务限制，处理后重新发送指令。"
+        if status in (401, 403):
+            return "规划模型认证或权限校验失败，请检查 API Key、业务空间及模型权限。"
+        if status == 429:
+            return "规划模型请求受到限流，请稍后重新发送指令。"
+        if isinstance(current, TimeoutError) or type(current).__name__ == "APITimeoutError":
+            return "规划模型响应超时，请稍后重新发送指令。"
+        current = current.__cause__ or current.__context__
+    return None
+
