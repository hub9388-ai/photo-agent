index 0000000..9b7ac75
--- /dev/null
+++ b/frontend/src/lib/postAdvice.ts
@@ -0,0 +1,48 @@
+/** Advice is data, never a chat instruction. Session storage contains no credentials. */
+export type PostAdvice = {
+  policy_version: 'post-sliders-v1'
+  source_job_id: string
+  source_media_id: string
+  source_result_id: string
+  params: Record<string, number>
+  converted: { parameter: string; label: string; source_value: number; source_unit: string;
+    target: string; value: number; approximate: boolean; clamped: boolean; rule: string; preview: boolean }[]
+  skipped: { parameter: string; source_value?: number | string | boolean | null; reason: string }[]
+}
+export type AdviceDraft = { advice: PostAdvice; values: Record<string, number>; revision: number; applied: boolean }
+const TARGETS = new Set(['contrast', 'highlights', 'shadows', 'saturation', 'vibrance', 'clarity'])
+const finite = (v: unknown): v is number => typeof v === 'number' && Number.isFinite(v)
+const short = (v: unknown): v is string => typeof v === 'string' && v.length > 0 && v.length <= 300
+
+export function parsePostAdvice(value: unknown): PostAdvice {
+  if (!value || typeof value !== 'object' || JSON.stringify(value).length > 16000) throw new Error('后期建议格式无效')
+  const a = value as PostAdvice
+  if (a.policy_version !== 'post-sliders-v1' || ![a.source_job_id, a.source_media_id, a.source_result_id].every(short) ||
+    !a.params || typeof a.params !== 'object' || Array.isArray(a.params) ||
+    !Object.entries(a.params).every(([k, v]) => TARGETS.has(k) && finite(v) && Math.abs(v) <= 1) ||
+    !Array.isArray(a.converted) || a.converted.length > 20 ||
+    !a.converted.every(r => r && short(r.parameter) && short(r.label) && short(r.source_unit) && short(r.rule) &&
+      finite(r.source_value) && Math.abs(r.source_value) <= 100 && TARGETS.has(r.target) && finite(r.value) &&
+      r.value === a.params[r.target] && typeof r.preview === 'boolean' && typeof r.clamped === 'boolean' && r.approximate === true) ||
+    Object.keys(a.params).length !== a.converted.length || new Set(a.converted.map(r => r.target)).size !== a.converted.length ||
+    !Array.isArray(a.skipped) || a.skipped.length > 100 || !a.skipped.every(r => r && short(r.parameter) && short(r.reason))) {
+    throw new Error('后期建议格式无效，请重新从分析页导入')
+  }
+  return a
+}
+
+const key = (sessionId: string) => `photoai:post-advice:${sessionId}`
+export function saveAdviceDraft(sessionId: string, draft: AdviceDraft) {
+  sessionStorage.setItem(key(sessionId), JSON.stringify(draft))
+}
+export function readAdviceDraft(sessionId: string): AdviceDraft | null {
+  try {
+    const raw = sessionStorage.getItem(key(sessionId))
+    if (!raw) return null
+    const draft = JSON.parse(raw) as AdviceDraft
+    parsePostAdvice(draft.advice)
+    if (!Number.isInteger(draft.revision) || typeof draft.applied !== 'boolean' || !draft.values ||
+      !Object.entries(draft.values).every(([k, v]) => ['brightness','contrast','highlights','shadows','temperature','tint','saturation','vibrance','sharpness','clarity','vignette'].includes(k) && finite(v) && Math.abs(v) <= 1)) return null
+    return draft
+  } catch { return null }
+}
